# E2E 테스트 설정 기본값 (DataInitializer 의 local-demo 데모 계정과 동일).
# 값을 바꾸려면 이 파일을 .env.e2e 로 복사해 수정하거나 같은 이름의 환경 변수를 지정한다.
# 우선순위: 환경 변수 > .env.e2e > .env.e2e.example
# 비밀번호는 webServer 기동 시 DEMO_COMPANYADMIN_PASSWORD / DEMO_SUPERADMIN_PASSWORD 로
# 앱에도 그대로 전달되어 데모 계정 생성 값과 항상 일치한다.

E2E_BASE_URL=http://localhost:8081

# 회사 관리자 (company_id=1, 허니레스트 스테이)
E2E_ADMIN_EMAIL=contact@honeyrest.com
E2E_ADMIN_PW=company1234

# 총관리자 (SUPER_ADMIN)
E2E_SUPER_EMAIL=admin@honeyrest.com
E2E_SUPER_PW=admin1234

# 1 이면 이미 떠 있는 서버(8081)를 재사용한다. 기본은 매번 새로 띄워 H2 데모 데이터를 초기화한다.
E2E_REUSE_SERVER=0

# 설치된 Playwright 브라우저 리비전이 패키지와 다를 때만 지정 (예: /opt/pw-browsers/chromium-1194/chrome-linux/chrome)
E2E_CHROMIUM_PATH=
